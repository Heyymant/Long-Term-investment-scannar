# Copy to .env and fill in. NEVER commit .env.

# --- Zerodha Kite Connect (read-only usage) ---
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
# Access token expires daily; obtained via the login flow.
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://127.0.0.1:8080/kite/callback

# --- Fundamentals provider ---
# eodhd | prowess | free
FUNDAMENTALS_PROVIDER=free
EODHD_API_KEY=

# --- Dashboard ---
DASHBOARD_BIND=127.0.0.1:8080
# Optional bearer token; if set, all /api routes require it.
DASHBOARD_AUTH_TOKEN=
ARTIFACTS_DIR=./artifacts
PYTHON_BIN=python
PYTHON_PROJECT_DIR=./python

# --- Optional alert webhooks ---
ALERT_WEBHOOK_URL=
